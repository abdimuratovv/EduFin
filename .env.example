# Nusxalab .env.local yarating va qiymatlarni to'ldiring. Haqiqiy kalitlarni Gitga kiritmang.

# Ota-ona rejimini ochish kodi (demo). Kamida 4 belgi.
PARENT_DEMO_PIN=

# Lokal SQLite fayl yo'li
DATABASE_PATH=./data/edufin.db

# AI ustoz (Gemini). Bo'sh bo'lsa tayyor yordam ishlaydi.
GEMINI_API_KEY=
GEMINI_MODEL=

# Ovoz (ElevenLabs). Bo'sh bo'lsa faqat tayyor audio fayllar ishlatiladi.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Ixtiyoriy: ELEVENLABS_MODEL=eleven_v4
